# =============================================================
# AI Universal Assistant — Environment Variables
# =============================================================
# انسخ هذا الملف إلى .env.local وأضف القيم الخاصة بك
# cp .env.example .env.local
# =============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# الموديل الافتراضي للنص (يمكن تغييره من الإعدادات لكل مستخدم)
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# موديل توليد الصور (dall-e-3 موصى به | dall-e-2 أرخص)
OPENAI_IMAGE_MODEL=dall-e-3

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Universal Assistant

# --- Limits (قابلة للتعديل) ---
FREE_USAGE_LIMIT=100
MAX_PDF_SIZE_MB=10

# --- (مستقبلاً) Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- (مستقبلاً) Video/Audio providers ---
# RUNWAY_API_KEY=
# ELEVENLABS_API_KEY=
