{
  "name": "loan-booking-desktop",
  "version": "1.0.0",
  "description": "برنامج حجز السلف - نسخة سطح المكتب",
  "main": "main.js",
  "author": "Loan Booking System",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:installer": "electron-builder --win nsis --x64 --publish never --config.directories.output=dist/installer",
    "dist:portable": "electron-builder --win portable --x64 --publish never --config.directories.output=dist/portable",
    "dist": "npm run dist:installer && npm run dist:portable"
  },
  "devDependencies": {
    "electron": "^43.7.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "iq.loanbooking.desktop",
    "productName": "برنامج حجز السلف",
    "asar": true,
    "files": [
      "main.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Loan-Booking-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "برنامج حجز السلف"
    }
  }
}
